{
 "run_name": "sportsmot-trainclips",
 "tasks": [
  {
   "task_key": "trainclips",
   "new_cluster": {
    "spark_version": "17.3.x-cpu-ml-scala2.13",
    "node_type_id": "Standard_D8ds_v5",
    "driver_node_type_id": "Standard_D8ds_v5",
    "num_workers": 0,
    "spark_conf": {
     "spark.databricks.cluster.profile": "singleNode",
     "spark.master": "local[*]"
    },
    "custom_tags": {
     "ResourceClass": "SingleNode"
    },
    "data_security_mode": "SINGLE_USER",
    "single_user_name": "<user>",
    "azure_attributes": {
     "availability": "ON_DEMAND_AZURE",
     "first_on_demand": 1,
     "spot_bid_max_price": -1
    },
    "enable_elastic_disk": true
   },
   "notebook_task": {
    "notebook_path": "/Users/<user>/Generative Tracker/scripts/ltx_make_dataset",
    "base_parameters": {
     "dataset": "sportsmot",
     "split": "train",
     "out_sub": "sportsmot_phase2_train",
     "max_per_seq": "0",
     "max_clips": "0"
    }
   },
   "timeout_seconds": 14400
  }
 ]
}